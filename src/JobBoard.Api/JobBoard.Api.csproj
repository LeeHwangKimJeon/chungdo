<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.28" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.27.0" />
  </ItemGroup>

  <ItemGroup>
    <ClientAppFiles Include="ClientApp/**/*" Exclude="ClientApp/node_modules/**/*" />
  </ItemGroup>

  <Target Name="BuildClient" BeforeTargets="Build" Inputs="@(ClientAppFiles)" Outputs="wwwroot/index.html" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp" Command="npm run build" />
  </Target>

</Project>
